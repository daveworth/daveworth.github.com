---
import GitHubProfileLink from './GitHubProfileLink.astro';

interface Props {
  showHeadshot?: boolean;
}

const { showHeadshot = true } = Astro.props;
---

<header class="text-center sm:text-center lg:text-left pb-4 sm:pb-6 lg:pb-0 border-b sm:border-b lg:border-b-0 border-gray-200">
  {showHeadshot && (
    <img
      src="/assets/pic.jpg"
      alt="My Smiling Face"
      class="w-24 h-24 sm:w-32 sm:h-32 rounded-full mx-auto lg:mx-0 mb-3 sm:mb-4"
    />
  )}
  <h1 class="text-xl sm:text-2xl font-bold text-site-heading">Dave Worth's STDOUT</h1>
  <p class="text-xs sm:text-sm mt-2 px-2 sm:px-0">
    the landing place of my various presentations, papers, and occasional blog posts
  </p>
  <div class="mt-3 sm:mt-4">
    <GitHubProfileLink />
  </div>
</header>
