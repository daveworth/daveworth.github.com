---
import DefaultLayout from '../layouts/DefaultLayout.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('posts', ({ data }) => data.published);
const sortedPosts = posts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<DefaultLayout>
  <section>
    <h2 class="text-lg sm:text-xl font-bold text-site-heading-secondary mb-3 sm:mb-4">
      Blog Posts, Presentations, Slide Decks, Papers, and even videos!
    </h2>
    <ul class="space-y-1.5 sm:space-y-2 text-sm sm:text-base">
      <li><span class="text-gray-500 text-[10px] sm:text-xs font-mono">2020-05-15</span> <span class="font-bold">&raquo;</span> <a href="https://grafana.com/go/grafanaconline/strava-the-venn-diagram-of-observability/" class="text-site-link hover:underline">The Venn Diagram of Observability</a> : for GrafanaCONline 2020</li>
      <li><span class="text-gray-500 text-[10px] sm:text-xs font-mono">2018-02-13</span> <span class="font-bold">&raquo;</span> <a href="https://blog.digitalocean.com/deep-end-podcast-muzzley/" class="text-site-link hover:underline">The Deep End Podcast Ep #13: From Prototype to Internet of Things with Muzzley</a> : a conversation with the founders of Muzzley following their startup story from origins and growth to today</li>
      <li><span class="text-gray-500 text-[10px] sm:text-xs font-mono">2017-07-19</span> <span class="font-bold">&raquo;</span> <a href="https://shows.acast.com/digitalocean-deep-end-podcast/episodes/5c479e6a3e349cc052abbf75" class="text-site-link hover:underline">Distributed Tracing Meets Kanye</a> : a great chat about operating software with Iheanyi Ekechukwu for DigitalOcean's Deep End Podcast</li>
      <li><span class="text-gray-500 text-[10px] sm:text-xs font-mono">2016-10-26</span> <span class="font-bold">&raquo;</span> <a href="https://www.digitalocean.com/blog/droplet-tagging-organize-your-infrastructure/" class="text-site-link hover:underline">Droplet Tagging: Organize Your Infrastructure</a></li>
      <li><span class="text-gray-500 text-[10px] sm:text-xs font-mono">2016-04-19</span> <span class="font-bold">&raquo;</span> <a href="http://www.slideshare.net/DavidWorth5/integration-testing-for-polyglot-ecosystems" class="text-site-link hover:underline">Integration Testing for Polyglot Ecosystems</a> : for Berlin Meetup Kickoff- DigitalOcean @Factory Berlin (<a href="https://www.youtube.com/watch?v=0I2bJpXlYSw#t=02m22s" class="text-site-link hover:underline">Video</a>)</li>
      <li><span class="text-gray-500 text-[10px] sm:text-xs font-mono">2015-10-07</span> <span class="font-bold">&raquo;</span> <a href="http://www.slideshare.net/david_e_worth/how-not-to-take-money" class="text-site-link hover:underline">How Not to Take Money</a> : for the ABQ Web Geeks meetup</li>
      <li><span class="text-gray-500 text-[10px] sm:text-xs font-mono">2015-06-17</span> <span class="font-bold">&raquo;</span> <a href="http://www.slideshare.net/david_e_worth/scaling-on-digitalocean" class="text-site-link hover:underline">Scaling on DigitalOcean</a> : for the Albuquerque WordPress Meetup</li>
      <li><span class="text-gray-500 text-[10px] sm:text-xs font-mono">2015-02-17</span> <span class="font-bold">&raquo;</span> <a href="http://www.slideshare.net/david_e_worth/from-zero-to-almost-rails-in-about-a-million-slides" class="text-site-link hover:underline">From zero to (almost) Ruby on Rails in about a million slides</a> : for a "local" Ruby study group</li>
      <li><span class="text-gray-500 text-[10px] sm:text-xs font-mono">2015-01-08</span> <span class="font-bold">&raquo;</span> <a href="https://www.digitalocean.com/blog/automating-application-deployments-with-user-data" class="text-site-link hover:underline">Automating App Deployments with User-Data</a></li>
      <li><span class="text-gray-500 text-[10px] sm:text-xs font-mono">2013-08-30</span> <span class="font-bold">&raquo;</span> <a href="https://dave.coffee/8_30_2013_BDD_Your_Infrastructure_with_Vagabond/#slide-0" class="text-site-link hover:underline">Big Nerd Ranch Tech Talk on BDDing Your Infrastructure with Vagabond</a></li>
      <li><span class="text-gray-500 text-[10px] sm:text-xs font-mono">2013-01-30</span> <span class="font-bold">&raquo;</span> <a href="http://www.wideteams.com/2013/01/30/episode-68-david-worth-of-big-nerd-ranch/" class="text-site-link hover:underline">Wide Teams #68</a></li>
      <li><span class="text-gray-500 text-[10px] sm:text-xs font-mono">2013-01-18</span> <span class="font-bold">&raquo;</span> <a href="https://www.bignerdranch.com/blog/creating-view-centric-interfaces-with-the-decorator-pattern/" class="text-site-link hover:underline">Creating View-Centric Interfaces with the Decorator Pattern</a></li>
      <li><span class="text-gray-500 text-[10px] sm:text-xs font-mono">2012-10-19</span> <span class="font-bold">&raquo;</span> <a href="/assets/GreHack-2012-talk-David_Worth_and_Justin_Collins-Leveraging_Convention_over_Configuration_for_Static_Analysis_in_Dynamic_Languages.pdf" class="text-site-link hover:underline">Leveraging Convention over Configuration for Static Analysis in Dynamic Languages</a> (<a href="/assets/GreHack-2012-Leveraging_Convention_over_Configuration_for_Static_Analysis_in_Dynamic_Languages.pdf" class="text-site-link hover:underline">Paper</a> : <a href="http://www.youtube.com/watch?feature=player_embedded&v=tHUxZbNktxg" class="text-site-link hover:underline">Video</a>) : for <a href="http://grehack.org/en/" class="text-site-link hover:underline">GreHack</a></li>
      <li><span class="text-gray-500 text-[10px] sm:text-xs font-mono">2012-10-05</span> <span class="font-bold">&raquo;</span> <a href="https://dave.coffee/ArrrrCamp_2012-DecoratorsAsInterfaces" class="text-site-link hover:underline">Decorators as Interfaces</a> : for ArrrrCamp'12 Lightning Talks</li>
      <li><span class="text-gray-500 text-[10px] sm:text-xs font-mono">2012-09-15</span> <span class="font-bold">&raquo;</span> <a href="https://dave.coffee/RubyHoedown_2012-StaticAnalysisAndSecurityAnalysisWithBrakeman" class="text-site-link hover:underline">Static Analysis of Ruby and Security Scanning of Rails Apps with Brakeman</a> : for RubyHoedown 2012 and ArrrrCamp'12</li>
      <li><span class="text-gray-500 text-[10px] sm:text-xs font-mono">2012-09-12</span> <span class="font-bold">&raquo;</span> <a href="https://dave.coffee/ATLRUG_07_2012-StaticAnalysisRuby/" class="text-site-link hover:underline">Static Analysis of Ruby</a> : for ATLRUG</li>
      <li><span class="text-gray-500 text-[10px] sm:text-xs font-mono">2012-07-26</span> <span class="font-bold">&raquo;</span> <a href="https://www.bignerdranch.com/blog/reaching-out-to-the-community-in-pursuit-of-responsible-disclosure/" class="text-site-link hover:underline">Reaching out to the community in pursuit of "Responsible Disclosure"</a></li>
      <li><span class="text-gray-500 text-[10px] sm:text-xs font-mono">2012-06-10</span> <span class="font-bold">&raquo;</span> <a href="https://www.bignerdranch.com/blog/evolving-a-security-auditing-methodology/" class="text-site-link hover:underline">Evolving a Security Auditing Methodology</a></li>
      <li><span class="text-gray-500 text-[10px] sm:text-xs font-mono">2012-05-25</span> <span class="font-bold">&raquo;</span> <a href="https://dave.coffee/5-25-2012-Highgroove-Tech-Talk---Decorators/" class="text-site-link hover:underline">Highgroove Tech Talk on Decorators</a></li>
      <li><span class="text-gray-500 text-[10px] sm:text-xs font-mono">2012-04-11</span> <span class="font-bold">&raquo;</span> <a href="https://dave.coffee/ATLRUG_04_2012-BrakemanPresentation/" class="text-site-link hover:underline">Brakeman - A Static Analysis Security Scanner for Rails Applications</a> : for ATLRUG</li>
      <li><span class="text-gray-500 text-[10px] sm:text-xs font-mono">2012-04-09</span> <span class="font-bold">&raquo;</span> <a href="https://www.bignerdranch.com/blog/cast-aside-that-debugger-and-use-your-test-suite/" class="text-site-link hover:underline">Cast aside that debugger and use your test-suite</a></li>
      <li><span class="text-gray-500 text-[10px] sm:text-xs font-mono">2012-02-22</span> <span class="font-bold">&raquo;</span> <a href="https://www.bignerdranch.com/blog/our-open-source-methodology-at-highgroove/" class="text-site-link hover:underline">Our Open-Source Methodology at Highgroove</a></li>
      <li><span class="text-gray-500 text-[10px] sm:text-xs font-mono">2012-02-06</span> <span class="font-bold">&raquo;</span> <a href="https://www.bignerdranch.com/blog/red-green-refactor-the-tools-for-success/" class="text-site-link hover:underline">Red, Green, Refactor – The Tools For Success</a></li>
      <li><span class="text-gray-500 text-[10px] sm:text-xs font-mono">2011-12-20</span> <span class="font-bold">&raquo;</span> <a href="https://www.bignerdranch.com/blog/using-rails-localization-outside-of-your-views/" class="text-site-link hover:underline">Using Rails localization outside of your views</a></li>
      <li><span class="text-gray-500 text-[10px] sm:text-xs font-mono">2006-12-01</span> <span class="font-bold">&raquo;</span> <a href="/assets/DaveWorthThesis.pdf" class="text-site-link hover:underline">Construction of Geometric Outer-Measures and Dimension Theory</a> : Masters Thesis</li>
      <li><span class="text-gray-500 text-[10px] sm:text-xs font-mono">2004-08-26</span> <span class="font-bold">&raquo;</span> <a href="https://ieeexplore.ieee.org/document/1384583" class="text-site-link hover:underline">Multiresolution metrics for detecting single-trial evoked response potentials (ERPS)</a> (via IEEEExplore) : Undergraduate Research Contribution</li>
      <li><span class="text-gray-500 text-[10px] sm:text-xs font-mono">2004-07-29</span> <span class="font-bold">&raquo;</span> <a href="/assets/bh-us-04-worth-up.pdf" class="text-site-link hover:underline">Cryptographic One-Time Knocking</a> : for Blackhat Vegas '04</li>
    </ul>
  </section>

  <section class="mt-6 sm:mt-8">
    <h2 class="text-lg sm:text-xl font-bold text-site-heading-secondary mb-3 sm:mb-4">
      Other Blog Posts and Lists
    </h2>
    <ul class="space-y-1.5 sm:space-y-2 text-sm sm:text-base">
      {sortedPosts.map((post) => (
        <li>
          <span class="text-gray-500 text-[10px] sm:text-xs font-mono">
            {post.data.pubDate.toISOString().split('T')[0]}
          </span>
          {' '}<span class="font-bold">&raquo;</span>{' '}
          <a href={`/posts/${post.id}/`} class="text-site-link hover:underline">
            {post.data.title}
          </a>
        </li>
      ))}
    </ul>
  </section>
</DefaultLayout>
