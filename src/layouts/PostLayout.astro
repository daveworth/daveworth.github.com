---
import BaseLayout from './BaseLayout.astro';
import BackToHome from '../components/BackToHome.astro';
import GitHubProfileLink from '../components/GitHubProfileLink.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  pubDate: Date;
  description?: string;
  image?: string;
}

const { title, pubDate, description, image } = Astro.props;

const formattedDate = pubDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<BaseLayout title={title} description={description} image={image}>
  <div class="max-w-4xl mx-auto px-4 py-8 lg:flex lg:gap-8">
    <aside class="lg:w-72 lg:flex-shrink-0 mb-8 lg:mb-0">
      <div class="lg:fixed lg:w-72">
        <header class="text-center lg:text-left">
          <h1 class="text-2xl font-bold text-site-heading">{title}</h1>
          <p class="text-sm text-gray-500 mt-2">{formattedDate}</p>
          <div class="mt-4">
            <BackToHome />
          </div>
          <div class="mt-2">
            <GitHubProfileLink />
          </div>
        </header>
      </div>
    </aside>
    <main class="flex-1 max-w-xl">
      <article class="prose prose-lg max-w-none">
        <slot />
      </article>
      <div class="mt-8 p-4 bg-gray-50 rounded">
        <p class="text-sm">
          Have something to contribute? Open an
          <a href="https://github.com/daveworth/daveworth.github.com/issues" class="text-site-link hover:underline">Issue</a>
          on <a href="https://github.com" class="text-site-link hover:underline">Github</a> and let's have a chat!
        </p>
      </div>
      <Footer />
    </main>
  </div>
</BaseLayout>
